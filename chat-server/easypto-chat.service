[Unit]
Description=easyPTO private chat API
After=network.target

[Service]
Type=simple
User=easypto-chat
Group=easypto-chat
EnvironmentFile=/etc/easypto-chat.conf
ExecStart=/usr/local/bin/easypto-chat-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/easypto-chat
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
