#!/usr/bin/env python3
import datetime as dt
import pathlib
import sqlite3

source_path = pathlib.Path("/var/lib/easypto-chat/chat.sqlite3")
backup_dir = pathlib.Path("/var/backups/easypto-chat")
backup_dir.mkdir(parents=True, exist_ok=True)
stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S-UTC")
target_path = backup_dir / f"chat-{stamp}.sqlite3"

with sqlite3.connect(f"file:{source_path}?mode=ro", uri=True) as source:
    with sqlite3.connect(target_path) as target:
        source.backup(target)
        result = target.execute("PRAGMA integrity_check").fetchone()[0]
        if result != "ok":
            target_path.unlink(missing_ok=True)
            raise RuntimeError(f"SQLite integrity check failed: {result}")
target_path.chmod(0o600)
cutoff = dt.datetime.now(dt.timezone.utc).timestamp() - 30 * 24 * 60 * 60
for old_backup in backup_dir.glob("chat-*.sqlite3"):
    if old_backup != target_path and old_backup.stat().st_mtime < cutoff:
        old_backup.unlink()
print(f"Created and verified {target_path.name}")
